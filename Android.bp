// Pre-generated Java from AIDL — zero AIDL compilation at platform build time

filegroup {
    name: "framework_native_aidl_binder",
    srcs: ["aidl/binder/**/*.aidl"],
    path: "aidl/binder",
}

filegroup {
    name: "framework_native_aidl_gui",
    srcs: ["aidl-gen/framework_native_aidl_gui/**/*.java"],
    path: "aidl-gen/framework_native_aidl_gui",
}

filegroup {
    name: "framework_native_aidl",
    srcs: [
        ":framework_native_aidl_binder",
        ":framework_native_aidl_gui",
    ],
}

aidl_library {
    name: "PersistableBundle_aidl",
    hdrs: ["aidl/binder/android/os/PersistableBundle.aidl"],
    strip_import_prefix: "aidl/binder",
}

filegroup {
    name: "guiconstants_aidl",
    srcs: [
        "aidl-gen/guiconstants/android/gui/DropInputMode.java",
        "aidl-gen/guiconstants/android/gui/StalledTransactionInfo.java",
        "aidl-gen/guiconstants/android/gui/TouchOcclusionMode.java",
